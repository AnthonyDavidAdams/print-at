#!/bin/bash
# Print@ command line. Mostly you never need this — the printer just works from the
# Print dialog. The one useful command is connecting this Mac to the Print@ cloud.
# Resolve symlinks (/usr/local/bin/printat -> <repo>/bin/printat) so DIR is the repo root.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do T="$(readlink "$SELF")"; case "$T" in /*) SELF="$T" ;; *) SELF="$(dirname "$SELF")/$T" ;; esac; done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
NODE="$(command -v node || true)"; [ -x "$DIR/.node/bin/node" ] && { [ -z "$NODE" ] || [ "$("$NODE" -p "process.versions.node.split(\".\")[0]" 2>/dev/null || echo 0)" -lt 22 ] 2>/dev/null; } && NODE="$DIR/.node/bin/node"
[ -n "$NODE" ] || { echo "Node.js not found. Re-run the installer: curl -fsSL https://printat.co/install.sh | bash"; exit 1; }
cmd="${1:-help}"; shift || true
case "$cmd" in
  connect)    exec "$NODE" "$DIR/agent/connect.js" "$@" ;;
  status)     exec "$NODE" "$DIR/agent/connect.js" --status ;;
  disconnect) exec "$NODE" "$DIR/agent/connect.js" --disconnect ;;
  bug)        exec "$NODE" "$DIR/agent/bug.js" "$@" ;;
  update)
    echo "==> Updating $DIR"
    git -C "$DIR" pull --ff-only || { echo "git pull failed (local changes?). Fix and re-run."; exit 1; }
    echo "==> Reinstalling (sudo needed for the CUPS backend)"
    exec sudo "$DIR/install.sh" ;;
  *)
    echo "Print@ — nearest print shop, from any Print dialog."
    echo
    echo "Usage:"
    echo "  printat connect [email]   Link this Mac to the Print@ cloud (printat.co):"
    echo "                            print through the network, branded sender, pickup"
    echo "                            codes — no local email setup."
    echo "  printat status            Show whether this Mac is connected."
    echo "  printat update            Pull the latest driver and reinstall."
    echo "  printat bug \"what happened\" [--screenshot file]   Send a bug report with diagnostics."
    echo "  printat disconnect        Go back to fully local mode (send from your own email)."
    echo
    echo "Print settings (priority, radius, shop type, color) live in the Print dialog."
    ;;
esac
