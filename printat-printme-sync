#!/usr/bin/env node
'use strict';
// Pull the PrintMe (EFI/Fiery) public directory via its JSON API into
// data/printme-<scope>.json. PrintMe powers Office Depot, Staples kiosks,
// libraries and campuses; documents go in by email (staples@printme.com and
// friends) or the PrintMe app, released at any kiosk with a PIN.
//   printat-printme-sync [us|world]
const fs = require('fs');
const path = require('path');

const SCOPE = (process.argv[2] || 'us').toLowerCase();
const OUT = path.join(__dirname, 'data', `printme-${SCOPE}.json`);
const HOSTS = ['https://selfserve-admin.com/api/v1/MapLocations/', 'https://staples.selfserve-admin.com/api/v1/MapLocations/'];
const UA = 'Mozilla/5.0 (Macintosh) Print@ directory sync';

// Grid of sweep centers. Overlapping 500-mile radii cover the ground; dedup handles overlap.
const GRID_US = [];
for (let lat = 25; lat <= 60; lat += 6) for (let lon = -125; lon <= -66; lon += 8) GRID_US.push([lat, lon]);
const GRID_WORLD = [
  [54, -2], [48, 10], [40, -4], [42, 12], [60, 18], [52, 20], [39, 22], [39, 35], [24, 47], [25, 55],
  [20, 78], [35, 105], [36, 138], [37, 127], [1.3, 104], [3, 102], [-2, 118], [13, 122], [16, 106],
  [-25, 134], [-41, 174], [-10, -52], [-33, -70], [4, -73], [10, -84], [23, -102], [9, 8], [-29, 24],
];
const GRID = SCOPE === 'world' ? [...GRID_US, ...GRID_WORLD] : GRID_US;
const RADIUS = 500;

async function fetchAt(host, lat, lon, attempt = 1) {
  try {
    const url = `${host}?radius=${RADIUS}&lat=${lat}&long=${lon}`;
    const res = await fetch(url, { headers: { 'User-Agent': UA, 'SSACMapData': 'printme', 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(25000) });
    if (!res.ok) throw new Error(`${res.status}`);
    const j = await res.json();
    return Array.isArray(j) ? j : [];
  } catch (e) {
    if (attempt <= 4) { await new Promise(r => setTimeout(r, 500 * attempt)); return fetchAt(host, lat, lon, attempt + 1); }
    console.error(`fail ${host} @${lat},${lon}: ${e.message}`);
    return [];
  }
}

function key(x) {
  return [x.MerchantNickname, x.Address1, x.City, x.Zip].map(s => (s || '').trim().toLowerCase()).join('|');
}

(async () => {
  const t0 = Date.now();
  const seen = new Map();
  let done = 0;
  const CONC = 6;
  const jobs = [];
  for (const [lat, lon] of GRID) for (const host of HOSTS) jobs.push({ host, lat, lon });
  let idx = 0;
  async function worker() {
    while (idx < jobs.length) {
      const j = jobs[idx++];
      const list = await fetchAt(j.host, j.lat, j.lon);
      for (const x of list) if (!seen.has(key(x))) seen.set(key(x), x);
      done++;
      if (done % 10 === 0) console.log(`${done}/${jobs.length} sweeps, ${seen.size} unique locations, ${Math.round((Date.now() - t0) / 1000)}s`);
    }
  }
  await Promise.all(Array.from({ length: CONC }, worker));

  const locs = [...seen.values()].map(x => ({
    merchant: x.MerchantNickname,
    name: x.LocationName,
    address: [x.Address1, x.Address2].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim() + `, ${x.City}, ${x.State} ${x.Zip}`.replace(/\s+,/g, ','),
    city: x.City, state: x.State, zip: x.Zip, country: x.CountryIso,
    lat: x.Latitude, lon: x.Longitude, phone: x.Phone || '',
  })).sort((a, b) => (a.merchant + a.state + a.city).localeCompare(b.merchant + b.state + b.city));

  const { Counter } = {};
  const byMerchant = {};
  for (const l of locs) byMerchant[l.merchant] = (byMerchant[l.merchant] || 0) + 1;
  fs.writeFileSync(OUT, JSON.stringify({ scope: SCOPE, fetched: new Date().toISOString(), count: locs.length, network: 'PrintMe', submit: 'email or PrintMe app; release at kiosk with PIN', locations: locs }, null, 1));
  console.log(`DONE: ${locs.length} PrintMe locations -> ${OUT} in ${Math.round((Date.now() - t0) / 1000)}s`);
  console.log('top merchants:', Object.entries(byMerchant).sort((a, b) => b[1] - a[1]).slice(0, 8));
})().catch(e => { console.error('FATAL', e); process.exit(1); });
