#!/usr/bin/env node
'use strict';
// Pull the PrinterOn public directory for one country into data/printeron-<cc>.json.
// Adaptive concurrency: starts at 8, halves on any throttle sign (non-200, timeout,
// error page) with exponential back-off, retries the item, ramps back up after a
// clean run. Resumable: finished cities are kept in the progress file.
//   printat-printeron-sync [US] [--max 10] [--fresh]
const fs = require('fs');
const path = require('path');

const COUNTRY = (process.argv[2] && !process.argv[2].startsWith('--')) ? process.argv[2] : 'US';
const MAX = Number((process.argv.find(a => a.startsWith('--max')) || '--max=10').split('=')[1] || 10);
const FRESH = process.argv.includes('--fresh');
const ROOT = __dirname;
const OUT = path.join(ROOT, 'data', `printeron-${COUNTRY.toLowerCase()}.json`);
const PROGRESS = path.join(ROOT, 'data', `.printeron-${COUNTRY.toLowerCase()}.progress.json`);
const BASE = 'https://www.printeron.net';
const UA = 'Mozilla/5.0 (Macintosh) Print@ directory sync (github.com/AnthonyDavidAdams/print-at)';
const COUNTRY_NAMES = { US: 'United States', CA: 'Canada', GB: 'United Kingdom', AU: 'Australia' };

const STATUS = path.join(ROOT, 'data', `.printeron-${COUNTRY.toLowerCase()}.status.json`);
const stats = { req: 0, ok: 0, fail: 0, backoffs: 0, started: Date.now() };
const recent = []; const history = []; let lastReq = 0, lastTick = Date.now();
let totals = { states: 0, cities: 0, citiesDone: 0, printers: 0, byState: {}, phase: 'starting', done: false };
function tick() {
  const now = Date.now(); const dt = (now - lastTick) / 1000 || 1;
  history.push({ t: now, rps: Math.round((stats.req - lastReq) / dt * 10) / 10, c: concurrency }); if (history.length > 180) history.shift();
  lastReq = stats.req; lastTick = now;
  try { fs.writeFileSync(STATUS, JSON.stringify({ ...totals, stats, concurrency, paused: Date.now() < pausedUntil, history, recent: recent.slice(-40), elapsed: Math.round((now - stats.started) / 1000), at: now })); } catch {}
}
setInterval(tick, 2000).unref();
let concurrency = Math.min(8, MAX), failStreak = 0, okStreak = 0, pausedUntil = 0;
const log = m => { const line = `${new Date().toISOString()} ${m}`; console.log(line); recent.push(line); if (recent.length > 200) recent.shift(); };

const sleep = ms => new Promise(r => setTimeout(r, ms));
const strip = s => s.replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();

// --- adaptive pool -------------------------------------------------------------
let active = 0; const waiters = [];
async function acquire() { while (active >= concurrency || Date.now() < pausedUntil) { await new Promise(r => waiters.push(r)); } active++; }
function release() { active--; const w = waiters.splice(0); w.forEach(r => r()); }
setInterval(() => { const w = waiters.splice(0); w.forEach(r => r()); }, 500).unref();

function throttled(status, body) {
  if (status === 429 || status === 503 || status >= 500) return true;
  if (body && /too many requests|access denied|rate limit/i.test(body) && body.length < 5000) return true;
  return false;
}
function onFail(what) {
  stats.fail++; failStreak++; okStreak = 0;
  const before = concurrency;
  concurrency = Math.max(1, Math.floor(concurrency / 2));
  const wait = Math.min(120000, 1000 * 2 ** Math.min(failStreak, 7));
  pausedUntil = Date.now() + wait;
  stats.backoffs++;
  log(`backoff: ${what}; concurrency ${before} -> ${concurrency}, pausing ${wait / 1000}s`);
}
function onOk() {
  stats.ok++; okStreak++; failStreak = 0;
  if (okStreak % 150 === 0 && concurrency < MAX) { concurrency++; log(`ramp: concurrency -> ${concurrency}`); }
}

async function get(url, cookie = '', attempt = 1) {
  await acquire();
  let released = false;
  const done = () => { if (!released) { released = true; release(); } };
  try {
    let jar = cookie;
    for (let hop = 0; hop < 6; hop++) {
      stats.req++;
      let res;
      try { res = await fetch(url, { headers: { 'User-Agent': UA, ...(jar ? { Cookie: jar } : {}) }, signal: AbortSignal.timeout(25000), redirect: 'manual' }); }
      catch (e) { throw Object.assign(new Error(`network: ${e.message}`), { retry: true }); }
      const sc = res.headers.get('set-cookie') || '';
      const jsid = (sc.match(/JSESSIONID=([^;]+)/) || [])[1];
      if (jsid) jar = `JSESSIONID=${jsid}`;
      if (res.status >= 300 && res.status < 400 && res.headers.get('location')) {
        url = new URL(res.headers.get('location'), url).toString();
        const pj = (url.match(/;jsessionid=([^?&/]+)/) || [])[1];
        if (pj) jar = `JSESSIONID=${pj}`;
        continue;
      }
      const text = await res.text();
      if (throttled(res.status, text)) throw Object.assign(new Error(`throttled ${res.status}`), { retry: true });
      if (!res.ok) throw Object.assign(new Error(`${res.status}`), { retry: res.status !== 404 });
      onOk();
      return Object.assign(new String(text), { cookie: jar });
    }
    throw new Error('redirect loop');
  } catch (e) {
    if (e.retry && attempt <= 5) { onFail(`${e.message} on ${url.slice(0, 90)} (attempt ${attempt})`); done(); await sleep(500); return get(url, cookie, attempt + 1); }
    throw e;
  } finally { done(); }
}

// --- parsing -------------------------------------------------------------------
function links(html, re) { return [...String(html).matchAll(re)].map(m => decodeURIComponent(m[1]).replace(/\+/g, ' ')); }
async function states() {
  const html = await get(`${BASE}/system/hotspot_search_frame.jsp?country=${encodeURIComponent(COUNTRY_NAMES[COUNTRY] || COUNTRY)}`);
  const hrefs = [...String(html).matchAll(/href="\/system\/hotspot_search_frame\.jsp\?country=([^&"]+)&state=([^"]+)"/g)].map(m => ({ cc: m[1], state: m[2].replace(/&amp;/g, '&') }));
  return hrefs;
}
async function cities(cc, state) {
  const html = await get(`${BASE}/system/hotspot_search_frame.jsp?country=${encodeURIComponent(cc)}&state=${encodeURIComponent(state)}`);
  return [...String(html).matchAll(/href="\/system\/hotspot_search_frame\.jsp\?country=([^&"]+)&state=([^&"]+)&city=([^"]+)"/g)].map(m => ({ cc: m[1], st: m[2].replace(/&amp;/g, '&'), city: m[3].replace(/&amp;/g, '&') }));
}
async function locations(cc, st, city) {
  const html = String(await get(`${BASE}/system/hotspot_search_frame.jsp?country=${encodeURIComponent(cc)}&state=${encodeURIComponent(st)}&city=${encodeURIComponent(city)}`));
  const out = [];
  const re = /<a[^>]*href="https:\/\/www\.printeron\.net\/([^";]+)[^"]*"[^>]*>([^<]+)<\/a>[\s\S]*?<br>\s*([\s\S]*?)<\/p>/gi;
  let m;
  while ((m = re.exec(html))) out.push({ path: m[1], name: strip(m[2]), address: strip(m[3]).replace(/\s*(UNITED STATES|CANADA)\s*$/i, '').replace(/\s+,/g, ','), city, state: st, country: cc });
  if (!out.length && (html.match(/printeron\.net\//g) || []).length) log(`parse miss: ${st}/${city} has anchors but no matches; sample: ${JSON.stringify(html.slice(html.indexOf('printeron.net/') - 80, html.indexOf('printeron.net/') + 200))}`);
  if (!out.length && html.length < 2500) log(`empty page: ${st}/${city} length ${html.length} url country=${cc}`);
  return out;
}
function field(d, label) { const m = d.match(new RegExp(label.replace(/[/&]/g, '\\$&') + ':\\s*([^:]{1,80}?)(?=\\s{2,}|\\s[A-Z][A-Za-z/&\\s]{2,25}:|$)')); return m ? m[1].trim() : ''; }
async function printer(loc) {
  const page = await get(`${BASE}/${loc.path}`);
  const html = String(page);
  const aliases = [...html.matchAll(/name="printerAlias"[^>]*value="(\d{12})"/g)].map(x => x[1]);
  if (!aliases.length) return { ...loc, printers: 0 };
  const alias = aliases[0];
  const out = { ...loc, alias, number: alias.replace(/^(\d{3})(\d{3})(\d{3})(\d{3})$/, '$1-$2-$3-$4'), email: `${alias.slice(3)}@printspots.com`, printers: aliases.length, color: null, model: '', cost: '' };
  try {
    const sid = page.cookie ? ';jsessionid=' + page.cookie.replace('JSESSIONID=', '') : '';
    const detailsUrl = `${BASE}/Page${sid}?FUNCTION=SearchServlet_search&printeraddress=${alias}&urlsearch=true&dd=true&lang=us`;
    let d = strip(String(await get(detailsUrl, page.cookie)));
    let pnum = (d.match(/Printer Number:\s*([\d-]{11,15})/) || [])[1];
    if (pnum && pnum !== out.number) {
      // The servlet reports the printer last selected in the session; select it the way the UI does, then ask again.
      await get(`${BASE}/system/printspot/interface/select_file.jsp${sid}?url=${encodeURIComponent(loc.path)}&printerAlias=${alias}&lang=en-us`, page.cookie);
      d = strip(String(await get(detailsUrl, page.cookie)));
      pnum = (d.match(/Printer Number:\s*([\d-]{11,15})/) || [])[1];
    }
    if (pnum && pnum !== out.number) throw new Error(`details mismatch: got ${pnum}, wanted ${out.number}`);
    out.details_verified = !!pnum;
    const em = d.match(/Email Address:\s*([\w.-]+@printspots\.com)/i); if (em) out.email = em[1];
    const cm = d.match(/Color\/B&W:\s*(Color|Black\s*&\s*White)/i); if (cm) out.color = /color/i.test(cm[1]);
    out.model = field(d, 'Model'); out.cost = field(d, 'Cost') || field(d, 'Price');
    const pn = d.match(/Printer Name:\s*([\w.-]+)/); if (pn) out.printer_name = pn[1];
  } catch (e) { out.details_error = e.message; }
  return out;
}

// --- main ----------------------------------------------------------------------
const TEST = (process.argv.find(a => a.startsWith('--city=')) || '').slice(7);
(async () => {
  if (TEST) {
    const [st, city] = TEST.split('/');
    const html = String(await get(`${BASE}/system/hotspot_search_frame.jsp?country=${COUNTRY}&state=${encodeURIComponent(st)}&city=${encodeURIComponent(city)}`));
    console.log('html length', html.length, 'anchors', (html.match(/printeron\.net\//g) || []).length);
    const locs = await locations(COUNTRY, st, city);
    console.log('locations', JSON.stringify(locs));
    for (const l of locs) console.log('printer', JSON.stringify(await printer(l)));
    process.exit(0);
  }
  const progress = (!FRESH && fs.existsSync(PROGRESS)) ? JSON.parse(fs.readFileSync(PROGRESS, 'utf8')) : { done: {}, items: [] };
  const save = () => { fs.writeFileSync(PROGRESS, JSON.stringify(progress)); };
  log(`PrinterOn sync ${COUNTRY}: start (max concurrency ${MAX}, ${Object.keys(progress.done).length} cities already done)`);
  totals.phase = 'listing states';
  const sts = await states();
  totals.states = sts.length; totals.phase = 'listing cities';
  log(`${sts.length} states/regions`);
  const cityList = [];
  await Promise.all(sts.map(async s => { try { cityList.push(...await cities(s.cc, s.state)); } catch (e) { log(`state ${s.state} failed: ${e.message}`); } }));
  totals.cities = cityList.length; totals.citiesDone = Object.keys(progress.done).length; totals.phase = 'scanning cities';
  for (const c of cityList) totals.byState[c.st] = totals.byState[c.st] || { cities: 0, done: 0, printers: 0 }, totals.byState[c.st].cities++;
  for (const k of Object.keys(progress.done)) { const st = k.split('/')[0]; if (totals.byState[st]) { totals.byState[st].done++; totals.byState[st].printers += progress.done[k]; } }
  totals.printers = progress.items.filter(i => i.alias).length;
  log(`${cityList.length} cities`);
  let n = 0, lastSave = Date.now();
  await Promise.all(cityList.map(async c => {
    const key = `${c.st}/${c.city}`;
    if (progress.done[key]) return;
    try {
      const locs = await locations(c.cc, c.st, c.city);
      const items = await Promise.all(locs.map(l => printer(l).catch(e => ({ ...l, error: e.message }))));
      progress.items.push(...items);
      progress.done[key] = items.length;
      totals.citiesDone++; totals.printers += items.filter(i => i.alias).length;
      if (totals.byState[c.st]) { totals.byState[c.st].done++; totals.byState[c.st].printers += items.filter(i => i.alias).length; }
    } catch (e) { log(`city ${key} failed: ${e.message}`); return; }
    n++;
    if (n % 50 === 0 || Date.now() - lastSave > 30000) {
      save(); lastSave = Date.now();
      const el = (Date.now() - stats.started) / 1000;
      log(`${Object.keys(progress.done).length}/${cityList.length} cities, ${progress.items.length} printers, ${stats.req} requests, ${(stats.req / el).toFixed(1)} req/s, concurrency ${concurrency}, backoffs ${stats.backoffs}`);
    }
  }));
  save();
  const items = progress.items.filter(i => i.alias).map(i => { const { details_error, ...rest } = i; return rest; });
  const byKey = new Map(); for (const i of items) byKey.set(`${i.alias}`, i);
  const final = [...byKey.values()].sort((a, b) => (a.state + a.city + a.name).localeCompare(b.state + b.city + b.name));
  fs.writeFileSync(OUT, JSON.stringify({ country: COUNTRY, fetched: new Date().toISOString(), count: final.length, printers: final }, null, 1));
  const el = Math.round((Date.now() - stats.started) / 1000);
  totals.phase = 'done'; totals.done = true; totals.printers = final.length; tick();
  log(`DONE: ${final.length} printers in ${Object.keys(progress.done).length} cities -> ${OUT}; ${stats.req} requests in ${el}s, ${stats.backoffs} backoffs`);
})().catch(e => { log(`FATAL: ${e.stack || e.message}`); process.exit(1); });
