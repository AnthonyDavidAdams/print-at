#!/bin/bash
# Print@(TM) CUPS backend.
# cupsd runs this as _lp inside the CUPS sandbox. It hands the spooled PDF plus the
# job options to the Print@ agent over localhost and then stays connected until
# the agent is done, relaying its progress as INFO lines. That keeps the job in the
# print queue, with a live status, until the file has actually reached a shop.
# Cancelling the job in the queue kills this process; the agent sees the socket
# close and cancels the dispatch.
#
# argv: job-id user title copies options [file]

PORT="${PRINTAT_PORT:-4243}"

if [ $# -eq 0 ]; then
  echo 'direct printat://localhost/ "Print@" "Print@ print-shop dispatcher" "MFG:PrintAt;MDL:Dispatcher;"'
  exit 0
fi
if [ $# -lt 5 ]; then
  echo "Usage: printat job-id user title copies options [file]" >&2
  exit 1
fi

JOB_ID="$1"; JOB_USER="$2"; TITLE="$3"; COPIES="$4"; OPTIONS="$5"; FILE="${6:--}"

b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

echo "STATE: -offline-report" >&2
echo "INFO: Sending to Print@ agent" >&2

if [ "$FILE" = "-" ]; then DATA="@-"; else DATA="@$FILE"; fi

GOT_ANY=0
LAST=""
while IFS= read -r line; do
  GOT_ANY=1
  case "$line" in
    DONE*|FAIL*) LAST="$line" ;;
    "") ;;
    *) echo "INFO: $line" >&2 ;;
  esac
done < <(curl -sN --max-time 3600 \
  -X POST "http://127.0.0.1:${PORT}/job" \
  -H "Content-Type: application/pdf" \
  -H "X-NP-Job-Id: ${JOB_ID}" \
  -H "X-NP-User: $(b64 "$JOB_USER")" \
  -H "X-NP-Title: $(b64 "$TITLE")" \
  -H "X-NP-Copies: ${COPIES}" \
  -H "X-NP-Options: $(b64 "$OPTIONS")" \
  -H "X-NP-Printer: ${PRINTER:-PrintAt}" \
  -H "X-NP-Device-Uri: $(b64 "${DEVICE_URI:-}")" \
  --data-binary "$DATA")

case "$LAST" in
  DONE*)
    echo "INFO: ${LAST#DONE }" >&2
    exit 0 ;;
  FAIL*)
    echo "ERROR: ${LAST#FAIL }" >&2
    exit 1 ;;                       # CUPS_BACKEND_FAILED
  *)
    if [ "$GOT_ANY" = 0 ]; then
      echo "STATE: +offline-report" >&2
      echo "ERROR: Print@ agent is not running (launchctl kickstart gui/\$UID/io.printat.agent)" >&2
      exit 6                        # CUPS_BACKEND_RETRY
    fi
    echo "ERROR: Lost contact with the Print@ agent mid-job" >&2
    exit 1 ;;
esac
